# --- Base de données (PostgreSQL, ex: Neon) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Sécurité ---
# Obligatoire en production. Générer avec : node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET="une-chaine-aleatoire-longue"

# --- Uploads d'images (Cloudinary) ---
# Si absent, les images sont stockées localement dans public/uploads (dev uniquement).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Divers ---
PORT=3000
